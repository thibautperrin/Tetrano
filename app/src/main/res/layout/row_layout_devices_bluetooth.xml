<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/apply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/apply"
        android:layout_centerVertical="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">
    </ImageView>

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/vert_clair"
        android:padding="5dp"
        android:textSize="@dimen/bluetooth_device_name"
        android:gravity="center_horizontal"
        android:layout_toLeftOf="@+id/reseau"
        android:layout_toStartOf="@+id/reseau"
        android:layout_toRightOf="@+id/apply"
        android:layout_toEndOf="@+id/apply">
    </TextView>

    <ImageView
        android:id="@+id/reseau"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/reseau"
        android:layout_centerVertical="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
    </ImageView>
</RelativeLayout>