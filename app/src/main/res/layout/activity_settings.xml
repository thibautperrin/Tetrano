<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context="thibautperrin.tetrano.SettingsActivity">


    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="@string/User_Name"
                android:id="@+id/TextNomUtilisateur"
                android:textSize="@dimen/Taille_Corps" />

            <EditText
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:ems="10"
                android:id="@+id/editTextNomUtilisateur"
                android:textSize="@dimen/Taille_Corps" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:text="@string/User_Color"
            android:textSize="@dimen/Taille_titre_3"
            android:id="@+id/TextCouleurUtilisateur"
            android:layout_marginTop="@dimen/Petite_marge" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="match_parent">

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/gris"
                android:id="@+id/tacheGrise5" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/noir"
                android:id="@+id/tacheNoir5" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/marron"
                android:id="@+id/tacheMarron5" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/orange"
                android:id="@+id/tacheOrange5" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/rouge"
                android:id="@+id/tacheRouge5" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/violet"
                android:id="@+id/tacheViolette5" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/bleu"
                android:id="@+id/tacheBleue5" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/vert"
                android:id="@+id/tacheVerte5" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:text="@string/Adversary_Color"
            android:id="@+id/TextCouleurAdversaire"
            android:textSize="@dimen/Taille_titre_3"
            android:layout_marginTop="@dimen/Petite_marge" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/gris"
                android:id="@+id/tacheGrise6" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/noir"
                android:id="@+id/tacheNoir6" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/marron"
                android:id="@+id/tacheMarron6" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/orange"
                android:id="@+id/tacheOrange6" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/rouge"
                android:id="@+id/tacheRouge6" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/violet"
                android:id="@+id/tacheViolette6" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/bleu"
                android:id="@+id/tacheBleue6" />

            <view
                style="@style/button_tache_style"
                class="thibautperrin.tetrano.TacheView"
                custom:couleurTache="@color/vert"
                android:id="@+id/tacheVerte6" />

        </LinearLayout>

        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/Confirm"
            android:id="@+id/boutonValiderReglages"
            android:layout_gravity="center_horizontal"
            android:textSize="@dimen/Taille_titre_3"
            android:background="#beffff32"
            android:textColor="#ff0000ff"
            android:textStyle="bold|italic"
            android:layout_marginTop="@dimen/Tres_petite_marge" />

    </LinearLayout>
</ScrollView>
























