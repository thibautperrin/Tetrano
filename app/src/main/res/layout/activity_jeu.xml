<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="thibautperrin.tetrano.JeuActivity"
    android:orientation="vertical"
    android:background="#ffffffff"
    android:clickable="false">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:id="@+id/linearLayout">


        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Play_Again"
            android:id="@+id/boutonRecommencer"
            android:textSize="@dimen/three_bottom_buttons"
            android:singleLine="false"
            android:layout_weight="50"
            android:layout_gravity="center"
            android:background="@color/boutonRecommencer"
            android:textColor="#ff0000ff"
            android:textStyle="bold|italic"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Mot_Clignoter"
            android:id="@+id/boutonClignoter"
            android:textSize="@dimen/three_bottom_buttons"
            android:singleLine="false"
            android:layout_weight="50"
            android:layout_gravity="center"
            android:background="@color/boutonClignoter"
            android:textColor="#ff0000ff"
            android:textStyle="bold|italic"/>
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Cancel"
            android:id="@+id/boutonAnnuler"
            android:textSize="@dimen/three_bottom_buttons"
            android:layout_weight="50"
            android:layout_gravity="center"
            android:background="@color/boutonAnnuler"
            android:textColor="#ff0000ff"
            android:textStyle="bold|italic"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/linearLayout"
        android:layout_alignParentStart="true">

        <view
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            class="thibautperrin.tetrano.packageSurfaceGraphView.SurfaceGraphView"
            android:id="@+id/surfaceGraphView"
            android:layout_gravity="top|center_horizontal" />
    </FrameLayout>




</RelativeLayout>
