<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context="thibautperrin.tetrano.JouerDeuxJoueurActivity">


    <LinearLayout
        android:id="@+id/layoutCouleurJoueur1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_toRightOf="@+id/textQuestionNomJoueur1"
        android:layout_toEndOf="@+id/textQuestionNomJoueur1"
        android:layout_marginStart="@dimen/Tres_petite_marge">

        <view
            android:id="@+id/tacheGrise1"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/gris" />

        <view
            android:id="@+id/tacheNoir1"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/noir" />

        <view
            android:id="@+id/tacheMarron1"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/marron" />

        <view
            android:id="@+id/tacheOrange1"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/orange" />

        <view
            android:id="@+id/tacheRouge1"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/rouge" />

        <view
            android:id="@+id/tacheViolette1"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/violet" />

        <view
            android:id="@+id/tacheBleue1"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/bleu" />

        <view
            android:id="@+id/tacheVerte1"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/vert" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutCouleurJoueur2"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignTop="@+id/textQuestionNomJoueur2"
        android:layout_toRightOf="@+id/textQuestionNomJoueur2"
        android:layout_toEndOf="@+id/textQuestionNomJoueur2"
        android:layout_marginStart="@dimen/Tres_petite_marge">

        <view
            android:id="@+id/tacheGrise2"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/gris" />

        <view
            android:id="@+id/tacheNoir2"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/noir" />

        <view
            android:id="@+id/tacheMarron2"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/marron" />

        <view
            android:id="@+id/tacheOrange2"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/orange" />

        <view
            android:id="@+id/tacheRouge2"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/rouge" />

        <view
            android:id="@+id/tacheViolette2"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/violet" />

        <view
            android:id="@+id/tacheBleue2"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/bleu" />

        <view
            android:id="@+id/tacheVerte2"
            style="@style/button_tache_style"
            class="thibautperrin.tetrano.TacheView"
            custom:couleurTache="@color/vert" />
    </LinearLayout>

    <TextView
        android:id="@+id/textQuestionNomJoueur1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Joueur1_Name"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="@dimen/Taille_Corps" />

    <EditText
        android:id="@+id/editTextNomJoueur1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:inputType="textPersonName"
        android:textSize="@dimen/Taille_Corps"
        android:layout_below="@+id/textQuestionNomJoueur1" />

    <TextView
        android:id="@+id/textQuestionNomJoueur2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Joueur2_Name"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="@dimen/Taille_Corps"
        android:layout_below="@+id/editTextNomJoueur1"
        android:layout_marginTop="@dimen/Petite_marge" />

    <EditText
        android:id="@+id/editTextNomJoueur2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:inputType="textPersonName"
        android:layout_below="@+id/textQuestionNomJoueur2"
        android:textSize="@dimen/Taille_Corps" />

    <Button
        android:id="@+id/buttonJouer"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="#beffff32"
        android:text="@string/Play"
        android:textColor="#ff0000ff"
        android:textSize="@dimen/Taille_titre_3"
        android:textStyle="bold|italic"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
