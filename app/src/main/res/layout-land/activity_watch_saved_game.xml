<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context="thibautperrin.tetrano.packageSavedGame.WatchSavedGameActivity">

    <thibautperrin.tetrano.packageSurfaceGraphView.SurfaceGraphView
        android:id="@+id/surfaceGraphViewWatchSavedGame"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/surfaceGraphViewWatchSavedGame"
        android:layout_toEndOf="@+id/surfaceGraphViewWatchSavedGame"
        android:layout_marginTop="@dimen/Grosse_marge">

        <TextView
            android:id="@+id/textDescriptionAnneau"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/Taille_titre_3"
            android:layout_centerInParent="true"
            android:layout_marginTop="@dimen/Tres_petite_marge" />

        <thibautperrin.tetrano.ButtonNextPrevious
            android:id="@+id/boutonPrecedent"
            android:layout_width="@dimen/Grosse_marge"
            android:layout_height="wrap_content"
            custom:next="false"
            custom:ratioWidthOnHeight="1.2"
            android:layout_above="@+id/textDescriptionAnneau"
            android:layout_alignLeft="@+id/textDescriptionAnneau"
            android:layout_alignStart="@+id/textDescriptionAnneau" />

        <thibautperrin.tetrano.ButtonNextPrevious
            android:id="@+id/boutonSuivant"
            android:layout_width="@dimen/Grosse_marge"
            android:layout_height="wrap_content"
            custom:next="true"
            custom:ratioWidthOnHeight="1.2"
            android:layout_alignBottom="@+id/boutonPrecedent"
            android:layout_alignRight="@+id/textDescriptionAnneau"
            android:layout_alignEnd="@+id/textDescriptionAnneau" />
    </RelativeLayout>

</RelativeLayout>
