<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffffff">


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:id="@+id/linearLayout2">


        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/Play_Again"
            android:id="@+id/boutonRecommencer"
            android:layout_weight="30"
            android:textSize="@dimen/three_bottom_buttons"
            android:singleLine="false"
            android:background="#beffff32"
            android:textColor="#ff0000ff"
            android:textStyle="bold|italic"
            android:paddingLeft="@dimen/Tres_petite_marge"
            android:paddingRight="@dimen/Tres_petite_marge" />

        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/Mot_Clignoter"
            android:id="@+id/boutonClignoter"
            android:layout_weight="30"
            android:textSize="@dimen/three_bottom_buttons"
            android:singleLine="false"
            android:background="#be96ff96"
            android:textColor="#ff0000ff"
            android:textStyle="bold|italic"
            android:paddingLeft="@dimen/Tres_petite_marge"
            android:paddingRight="@dimen/Tres_petite_marge" />


        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/Cancel"
            android:id="@+id/boutonAnnuler"
            android:layout_weight="30"
            android:textSize="@dimen/three_bottom_buttons"
            android:background="#be32ffff"
            android:textColor="#ff0000ff"
            android:textStyle="bold|italic"
            android:paddingLeft="@dimen/Tres_petite_marge"
            android:paddingRight="@dimen/Tres_petite_marge" />


    </LinearLayout>

        <view
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            class="thibautperrin.tetrano.packageSurfaceGraphView.SurfaceGraphView"
            android:id="@+id/surfaceGraphView"
            android:layout_gravity="start|center_vertical" />
</RelativeLayout>