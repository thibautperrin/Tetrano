<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffffff">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Rings_used"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:id="@+id/textViewRingsUsed"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/Tres_petite_marge"
            android:layout_marginEnd="@dimen/Tres_petite_marge"
            android:background="@color/infoRingsNumber"
            android:layout_toRightOf="@+id/surfaceGraphViewChallenge"
            android:layout_toEndOf="@+id/surfaceGraphViewChallenge"
            android:layout_marginStart="@dimen/Tres_petite_marge"
            android:gravity="center_horizontal"
            android:onClick="onClickNbRings"
            android:clickable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:id="@+id/textViewRingsUsed2"
            android:layout_below="@+id/textViewRingsUsed"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@+id/surfaceGraphViewChallenge"
            android:background="@color/infoRingsNumber"
            android:gravity="center_horizontal"
            android:layout_marginEnd="@dimen/Tres_petite_marge"
            android:layout_toRightOf="@+id/surfaceGraphViewChallenge"
            android:layout_marginStart="@dimen/Tres_petite_marge"
            android:onClick="onClickNbRings"
            android:clickable="true" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Abandon_Challenge"
            android:id="@+id/buttonRestartChallenge"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:textSize="@dimen/three_bottom_buttons"
            android:singleLine="false"
            android:background="@color/buttonGiveUp"
            android:textStyle="bold|italic"
            android:paddingLeft="@dimen/Tres_petite_marge"
            android:paddingRight="@dimen/Tres_petite_marge"
            android:layout_marginEnd="@dimen/Tres_petite_marge"
            android:layout_marginBottom="@dimen/Tres_petite_marge"
            android:layout_toRightOf="@+id/surfaceGraphViewChallenge"
            android:layout_toEndOf="@+id/surfaceGraphViewChallenge"
            android:layout_marginStart="@dimen/Tres_petite_marge" />

        <view
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            class="thibautperrin.tetrano.packageSurfaceGraphView.SurfaceGraphView"
            android:id="@+id/surfaceGraphViewChallenge"
            android:layout_gravity="start|top"
            android:layout_alignParentStart="true" />
</RelativeLayout>